<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingRight="12dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp">

        <TextView
            android:id="@+id/lblEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center|start"
            android:text="PENDIENTE"
            android:padding="5dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textSize="12sp"
            android:textAlignment="center"
            android:textColor="@color/blanco"
            android:background="@color/rojo_pintuco"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="10">

            <TextView
                android:id="@+id/lblSku"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="8"
                android:gravity="center|start"
                android:hint="@string/marcas"
                android:padding="5dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:textColor="#000000"
                android:layout_column="0"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <ImageButton
                        android:id="@+id/ibCargarFoto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="#0000"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"
                        app:srcCompat="@drawable/cameraicon2" />

                    <ImageButton
                        android:id="@+id/ibPreview"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="#0000"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"
                        app:srcCompat="@drawable/ic_baseline_preview_24" />

                </LinearLayout>

                <TextView
                    android:id="@+id/lblEstadoFoto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center|start"
                    android:text="NO FOTO"
                    android:padding="5dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:textSize="8sp"
                    android:textAlignment="center"
                    android:textColor="@color/blanco"
                    android:background="@color/rojo_pintuco"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <Spinner
            android:id="@+id/spConteoTotal"
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:ems="10"
            android:entries="@array/comboConteo"
            android:fontFamily="@font/roboto_light"
            android:hint="No"
            android:inputType="textPersonName"
            android:textSize="18sp"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:weightSum="1">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_column="0"
                android:layout_weight="1"
                android:background="@drawable/edit_text_background"
                android:gravity="center|start"
                android:padding="5dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="Total Stock"
                android:textAlignment="center"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:weightSum="4">

            <RadioGroup
                android:id="@+id/rgConteoTotal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <RadioButton
                    android:id="@+id/rbUnidadesTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_light_italic"
                    android:text="@string/unidades" />

                <RadioButton
                    android:id="@+id/rbCajasTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_light_italic"
                    android:text="@string/cajas" />

            </RadioGroup>

            <EditText
                android:id="@+id/txtTotal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center|start"
                android:hint="@string/total"
                android:inputType="number"
                android:maxLength="5"
                android:paddingEnd="2dp"
                android:paddingStart="2dp"
                android:textAlignment="center"
                android:textColor="#000000"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="vertical"
                android:weightSum="10">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center|start"
                    android:padding="5dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:layout_column="0"
                    android:text="@string/fecha_caducidad"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_margin="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/lblFechaCaducidadTotal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textAlignment="center" />

                    <ImageButton
                        android:id="@+id/btnFechaCaducidadTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_vertical|end"
                        android:background="@drawable/edit_text_background"
                        android:src="@android:drawable/ic_menu_my_calendar" />
                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:weightSum="1">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center|start"
                android:padding="5dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:layout_column="0"
                android:background="@drawable/edit_text_background"
                android:text="Unidades Defectuosas"
                android:textSize="14sp"
                android:textAlignment="center"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="visible"
            android:weightSum="4">

            <RadioGroup
                android:id="@+id/rgConteoDefectuoso"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1">

                <RadioButton
                    android:id="@+id/rbUnidadesDefectuosas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_light_italic"
                    android:text="@string/unidades" />

                <RadioButton
                    android:id="@+id/rbCajasDefectuosas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_light_italic"
                    android:text="@string/cajas" />

            </RadioGroup>

            <EditText
                android:id="@+id/txtDefectuosos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight=".9"
                android:gravity="center|start"
                android:hint="@string/unidades_defectuosas"
                android:inputType="number"
                android:maxLength="5"
                android:paddingEnd="2dp"
                android:paddingStart="2dp"
                android:textAlignment="center"
                android:textColor="#000000"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="vertical"
                android:weightSum="10">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center|start"
                    android:padding="5dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:layout_column="0"
                    android:text="Causales"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_margin="5dp"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/spCausales"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_light"
                        android:layout_margin="5dp"
                        android:entries="@array/seleccione"
                        android:hint="Producto En Trastienda/Almacen"
                        android:inputType="textPersonName" />


                </FrameLayout>

            </LinearLayout>



        </LinearLayout>

        <LinearLayout
            android:id="@+id/llPDVLogistica"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="visible"
            android:weightSum="4">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.90"
                android:gravity="center|start"
                android:hint="Por favor, Seleccione una opción"
                android:maxLength="5"
                android:paddingEnd="2dp"
                android:paddingStart="2dp"
                android:textAlignment="center"
                android:textColor="#000000"
                android:textSize="10sp" />

            <RadioGroup
                android:id="@+id/rgPDVLogistica"
                android:layout_width="0dp"
                android:layout_weight="2.1"
                android:orientation="horizontal"
                android:visibility="visible"
                android:layout_height="30dp">

                <RadioButton
                    android:id="@+id/rbLogistica"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_light_italic"
                    android:text="@string/logistica" />

                <RadioButton
                    android:id="@+id/rbBodega"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_light_italic"
                    android:text="@string/pdv" />

            </RadioGroup>




        </LinearLayout>

        <Spinner
            android:id="@+id/spConteoDefectuoso"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:ems="10"
            android:entries="@array/comboConteo"
            android:fontFamily="@font/roboto_light"
            android:hint="Si"
            android:inputType="textPersonName"
            android:textSize="18sp"
            android:visibility="gone"/>

