<!--                android:textSize="14sp" />-->

<!--        </LinearLayout>-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:weightSum="10">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4"
                android:gravity="center|start"
                android:padding="5dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:layout_column="0"
                android:text="Causales"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spCausales2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="6"
                android:fontFamily="@font/roboto_light"
                android:layout_margin="5dp"
                android:entries="@array/seleccione"
                android:hint="Producto En Trastienda/Almacen"
                android:inputType="textPersonName" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="10"
            android:visibility="gone">

<!--            <ImageButton-->
<!--                android:id="@+id/ibCargarFoto"-->
<!--                android:layout_width="0dp"-->
<!--                android:layout_height="256px"-->
<!--                android:layout_weight="3"-->
<!--                android:background="#0000"-->
<!--                android:scaleType="fitCenter"-->
<!--                app:srcCompat="@drawable/cameraicon2" />-->

            <ImageView
                android:id="@+id/ivFoto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="7"/>

        </LinearLayout>

        <Button
            android:id="@+id/checkGuardar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/button_background"
            android:layout_margin="5dp"
            android:textColor="@color/blanco"
            android:text="Guardar"/>

