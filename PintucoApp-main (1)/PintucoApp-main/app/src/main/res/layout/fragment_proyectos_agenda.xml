<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshAgenda"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorWhite"
        android:orientation="vertical">

        <!-- Navegacion de mes: queda siempre fija arriba, no se va con el scroll de la lista -->
        <LinearLayout
            android:id="@+id/filaMes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/ivMesAnterior"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="18dp"
                android:padding="4dp"
                android:scaleX="-1"
                android:src="@drawable/chevron_right_36"
                app:tint="@color/azul_pintuco" />

            <TextView
                android:id="@+id/tvMesActual"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/roboto_medium"
                android:gravity="center"
                android:padding="6dp"
                android:textColor="@color/azul_pintuco"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="JUNIO" />

            <ImageView
                android:id="@+id/ivMesSiguiente"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="18dp"
                android:padding="4dp"
                android:src="@drawable/chevron_right_36"
                app:tint="@color/azul_pintuco" />

        </LinearLayout>

        <!-- Pendientes / Visitados: alterna la lista y los badges del calendario sin recargar de la base -->
        <LinearLayout
            android:id="@+id/filaPillsAgenda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pillAgendaPendientes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_pill_activo"
                android:ellipsize="end"
                android:fontFamily="@font/roboto_medium"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingTop="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp"
                android:textColor="@color/proforma_titulo"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Agenda (7)" />

            <TextView
                android:id="@+id/pillAgendaVisitados"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_pill_inactivo"
                android:ellipsize="end"
                android:fontFamily="@font/roboto_medium"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingTop="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp"
                android:textColor="@color/plomo_pintuco"
                android:textSize="11sp"
                tools:text="Visitados (3)" />

        </LinearLayout>

        <!-- Encabezado fijo de letras de los dias de la semana -->
        <LinearLayout
            android:id="@+id/filaLetrasDias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <TextView style="@style/LetraDiaSemanaAgenda" android:text="L" />
            <TextView style="@style/LetraDiaSemanaAgenda" android:text="M" />
            <TextView style="@style/LetraDiaSemanaAgenda" android:text="M" />
            <TextView style="@style/LetraDiaSemanaAgenda" android:text="J" />
            <TextView style="@style/LetraDiaSemanaAgenda" android:text="V" />
            <TextView style="@style/LetraDiaSemanaAgenda" android:text="S" />
            <TextView style="@style/LetraDiaSemanaAgenda" android:text="D" />

        </LinearLayout>

        <com.kizitonwose.calendar.view.CalendarView
            android:id="@+id/calendarView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cv_dayViewResource="@layout/calendar_day_agenda"
            app:cv_orientation="horizontal"
            app:cv_scrollPaged="true" />

        <View
            android:id="@+id/divisorAgenda"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:background="#E0E4E8" />

        <!--
            La lista es ahora quien scrollea de verdad (antes un NestedScrollView envolvia
            todo, lo que hacia que tocar un dia del calendario sacara el calendario de la
            pantalla). Asi el calendario queda siempre visible arriba y el encabezado del
            dia "pegajoso" (StickyHeaderDecoration) puede calcularse sobre el scroll real
            del RecyclerView.
        -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAgenda"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="18dp"
            android:paddingTop="6dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp" />

    </LinearLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
