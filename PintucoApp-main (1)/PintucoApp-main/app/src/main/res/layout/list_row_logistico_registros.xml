<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/alicorp_fondo"
    android:orientation="horizontal"
    android:weightSum="18"
    android:padding="5dp">

    <TextView
        android:id="@+id/lblSku"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="6.4"
        android:gravity="center|start"
        android:hint="@string/marcas"
        android:padding="5dp"
        android:textColor="#000000"
        android:layout_column="0"
        android:textStyle="bold" />


    <EditText
        android:id="@+id/txtCantidad"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.5"
        android:gravity="center|start"
        android:inputType="number"
        android:layout_column="2"
        android:maxLength="2"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:textAlignment="center"
        android:imeOptions="actionNext"
        android:textColor="#000000"
        android:textSize="14sp" />

    <Spinner
        android:id="@+id/spCausalRelevo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="7.0"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:layout_gravity="top"
        android:gravity="top"
        android:visibility="visible"/>

<!--    <androidx.appcompat.widget.AppCompatCheckBox-->
<!--        android:id="@+id/spCausalRelevo"-->
<!--        android:layout_width="0dp"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:layout_weight="2.0"-->
<!--        android:textColor="@android:color/white"-->
<!--        android:padding="5dp"-->
<!--        android:visibility="visible" />-->

<!--    <Spinner-->
<!--        android:id="@+id/spTipos"-->
<!--        android:layout_width="0dp"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:layout_weight="4"-->
<!--        android:paddingStart="2dp"-->
<!--        android:paddingEnd="2dp"-->
<!--        android:layout_gravity="top"-->
<!--        android:gravity="top"-->
<!--        android:entries="@array/causal_prueba2"-->
<!--        android:visibility="gone"/>-->


    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.0"
        android:orientation="vertical"
        android:gravity="center">

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/checkGuardar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp" />
    </LinearLayout>





</LinearLayout>

