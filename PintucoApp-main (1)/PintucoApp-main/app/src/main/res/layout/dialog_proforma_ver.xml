<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/proforma_dialog_ver_titulo"
                android:textColor="@color/proforma_titulo"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Solo visible en modo solo-lectura (visita ya guardada): cierra sin
                 ofrecer Cancelar/Aceptar, porque acá no hay nada que confirmar. -->
            <ImageView
                android:id="@+id/ivCerrarVer"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:padding="2dp"
                android:src="@drawable/ic_cerrar"
                android:visibility="gone"
                app:tint="@color/plomo_pintuco" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="12dp">

            <ImageView
                android:id="@+id/ivPreviewEvidencia"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/proforma_pendiente_bg"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_camera" />

            <ImageView
                android:id="@+id/ivZoomEvidencia"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_zoom_overlay_circulo"
                android:padding="6dp"
                android:src="@drawable/ic_zoom" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvSinEvidencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/proforma_dialog_sin_evidencia"
            android:textColor="@color/plomo_pintuco"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/roboto_medium"
            android:text="@string/proforma_dialog_caracteristica_label"
            android:textColor="@color/colorBlack"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_proyectos"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etCaracteristicaVisita"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/proforma_dialog_caracteristica_hint"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/roboto_medium"
            android:text="@string/proforma_dialog_acompanamiento_label"
            android:textColor="@color/colorBlack"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/rgAcompanamientoTecnico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbAcompanamientoSi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:text="@string/proforma_si" />

            <RadioButton
                android:id="@+id/rbAcompanamientoNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/proforma_no" />

        </RadioGroup>

        <!-- Precio Proforma sin iva propuesto por el promotor — obligatorio para poder guardar.
             Mismo campo que monto_validado (ver RegistroProforma.montoValidado). -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/roboto_medium"
            android:text="@string/proforma_dialog_monto_propuesto_label"
            android:textColor="@color/colorBlack"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_proyectos"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etMontoPropuesto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/proforma_dialog_monto_propuesto_hint"
                android:inputType="numberDecimal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="13sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/filaBotonesVer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCancelarVer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:padding="8dp"
                android:text="@string/proforma_dialog_cancelar"
                android:textColor="@color/plomo_pintuco" />

            <TextView
                android:id="@+id/btnGuardarVer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_proforma_realizado"
                android:fontFamily="@font/roboto_medium"
                android:paddingStart="18dp"
                android:paddingTop="10dp"
                android:paddingEnd="18dp"
                android:paddingBottom="10dp"
                android:text="@string/proforma_dialog_guardar"
                android:textColor="@color/proforma_realizado_texto"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
