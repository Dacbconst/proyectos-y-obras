<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/alicorp_fondo"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lblSku"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:hint="@string/marcas"
            android:padding="5dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textColor="#000000"
            android:textStyle="bold" />

        <!--<EditText
            android:id="@+id/txtFecha"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_column="1"
            android:layout_weight=".25"
            android:gravity="center|start"
            android:hint="dd/mm/yyyy"
            android:inputType="numberDecimal"
            android:maxLength="10"
            android:maxLines="10"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textAlignment="textStart"
            android:textColor="#000000"
            android:textSize="14sp" />-->

        <EditText
            android:id="@+id/txtCantidad"
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:gravity="center|start"
            android:hint="Stock"
            android:inputType="numberDecimal"
            android:maxLength="5"
            android:maxLines="5"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textAlignment="textStart"
            android:textColor="#000000"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/txtSugerido"
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:gravity="center|start"
            android:hint="Sugerido"
            android:inputType="numberDecimal"
            android:maxLength="5"
            android:maxLines="5"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textAlignment="textStart"
            android:textColor="#000000"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/txtObservacion"
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:gravity="center|start"
            android:hint="Observación"
            android:inputType="textPersonName"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textAlignment="textStart"
            android:textColor="#000000"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="130dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtFecha"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="left|center_vertical"
                android:maxLength="10"
                android:textColor="@color/negro" />

            <ImageButton
                android:id="@+id/btnFechaProd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:background="@drawable/edit_text_background"
                android:src="@android:drawable/ic_menu_my_calendar" />

        </FrameLayout>

        <!--<EditText
            android:id="@+id/txt_precio_oferta"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight=".15"
            android:gravity="center|start"
            android:hint="$"
            android:inputType="numberDecimal"
            android:maxLength="5"
            android:maxLines="5"
            android:layout_column="2"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textAlignment="textStart"
            android:textColor="#000000"
            android:textSize="14sp" />-->

        <CheckBox
            android:id="@+id/checkGuardar"
            android:layout_width="35dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical|center_horizontal|center" />

    </LinearLayout>

</LinearLayout>