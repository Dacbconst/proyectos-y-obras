<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorWhite"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/camposContacto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Campos automáticos: fecha, usuario, pdv -->
        <LinearLayout
            style="@style/FilaContactoProyectos"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_calendar_24" />

            <EditText
                android:id="@+id/etFechaContacto"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_proyectos"
                android:enabled="false"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/plomo_pintuco"
                android:textSize="13sp" />

        </LinearLayout>

        <LinearLayout
            style="@style/FilaContactoProyectos"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_person_24" />

            <EditText
                android:id="@+id/etUsuarioContacto"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_proyectos"
                android:enabled="false"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/plomo_pintuco"
                android:textSize="13sp" />

        </LinearLayout>

        <LinearLayout
            style="@style/FilaContactoProyectos"
            android:layout_marginBottom="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_place_24" />

            <RelativeLayout
                android:id="@+id/layoutPdvContacto"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_proyectos"
                android:clickable="true"
                android:focusable="true">

                <EditText
                    android:id="@+id/etPdvContacto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/ivChevronPdvContacto"
                    android:background="@null"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:gravity="center_vertical"
                    android:hint="@string/contacto_hint_pdv"
                    android:paddingStart="16dp"
                    android:textColor="@color/plomo_pintuco"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/ivChevronPdvContacto"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="6dp"
                    android:alpha="0.6"
                    android:padding="10dp"
                    android:src="@drawable/drop_down" />

            </RelativeLayout>

        </LinearLayout>

        <!-- CONTACTO -->
        <LinearLayout
            style="@style/FilaContactoProyectos"
            android:layout_marginBottom="10dp">

            <TextView
                style="@style/LabelContactoProyectos"
                android:text="@string/contacto_label_contacto" />

            <EditText
                android:id="@+id/etContacto"
                style="@style/InputContactoProyectos"
                android:hint="@string/contacto_hint_contacto"
                android:inputType="textPersonName" />

        </LinearLayout>

        <!-- EMPRESA -->
        <LinearLayout
            style="@style/FilaContactoProyectos"
            android:layout_marginBottom="10dp">

            <TextView
                style="@style/LabelContactoProyectos"
                android:text="@string/contacto_label_empresa" />

            <EditText
                android:id="@+id/etEmpresa"
                style="@style/InputContactoProyectos"
                android:hint="@string/contacto_hint_empresa"
                android:inputType="textCapWords" />

        </LinearLayout>

        <!-- MAIL: el mismo campo sugiere el dominio al escribir @ -->
        <LinearLayout
            style="@style/FilaContactoProyectos"
            android:layout_marginBottom="10dp">

            <TextView
                style="@style/LabelContactoProyectos"
                android:text="@string/contacto_label_mail" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_proyectos"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <AutoCompleteTextView
                    android:id="@+id/etMail"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:completionThreshold="1"
                    android:dropDownAnchor="@id/etMail"
                    android:hint="@string/contacto_hint_mail"
                    android:inputType="textEmailAddress"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/ivDominioMail"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:alpha="0.6"
                    android:padding="10dp"
                    android:src="@drawable/drop_down"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <!-- DIRECCION -->
        <LinearLayout
            style="@style/FilaContactoProyectos"
            android:layout_marginBottom="10dp">

            <TextView
                style="@style/LabelContactoProyectos"
                android:text="@string/contacto_label_direccion" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_proyectos"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etDireccion"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/contacto_hint_direccion"
                    android:inputType="textPostalAddress"
                    android:paddingStart="16dp"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/ivBuscarDireccion"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:padding="8dp"
                    android:src="@drawable/baseline_search_24" />

            </LinearLayout>

        </LinearLayout>

        <!-- TELEFONO -->
        <LinearLayout
            style="@style/FilaContactoProyectos"
            android:layout_marginBottom="10dp">

            <TextView
                style="@style/LabelContactoProyectos"
                android:text="@string/contacto_label_telefono" />

            <EditText
                android:id="@+id/ettelefono"
                style="@style/InputContactoProyectos"
                android:hint="@string/contacto_hint_telefono"
                android:inputType="phone"
                android:maxLength="10" />

        </LinearLayout>

        <!-- TELEFONO CONVENCIONAL (opcional) -->
        <LinearLayout
            style="@style/FilaContactoProyectos"
            android:layout_marginBottom="10dp">

            <TextView
                style="@style/LabelContactoProyectos"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="10sp"
                android:text="@string/contacto_label_telefono_convencional" />

            <EditText
                android:id="@+id/etTelefonoConvencional"
                style="@style/InputContactoProyectos"
                android:hint="@string/contacto_hint_telefono_convencional"
                android:textColorHint="@color/plomo_pintuco"
                android:inputType="phone"
                android:maxLength="10" />

        </LinearLayout>

        <!-- AGENDAMIENTO -->
        <TextView
            style="@style/LabelContactoProyectos"
            android:layout_marginBottom="12dp"
            android:text="@string/contacto_label_agendamiento" />

        <CheckBox
            android:id="@+id/cbNoRequiereVisita"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:buttonTint="@color/azul_pintuco"
            android:fontFamily="@font/roboto_medium"
            android:text="@string/contacto_check_no_requiere_visita"
            android:textColor="@color/text_color"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/llAgendamientoCampos"
            style="@style/FilaContactoProyectos"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_input_proyectos"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivAgendamientoFecha"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_calendar_24" />

                <EditText
                    android:id="@+id/etAgendamiento"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"

                    android:drawablePadding="6dp"
                    android:focusable="false"
                    android:hint="@string/contacto_hint_agendamiento"
                    android:paddingStart="12dp"
                    android:textSize="13sp" />



            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_proyectos"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/ivHoraTentativa"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_clock_24" />


                <EditText
                    android:id="@+id/etHoraTentativa"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"

                    android:drawablePadding="6dp"
                    android:focusable="false"
                    android:hint="@string/contacto_hint_hora_tentativa"
                    android:paddingStart="12dp"
                    android:textSize="13sp" />



            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/btnGuardarContacto"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_button_guardar_proyectos"
            android:gravity="center"
            android:text="@string/contacto_btn_guardar"
            android:textColor="@color/colorWhite"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
