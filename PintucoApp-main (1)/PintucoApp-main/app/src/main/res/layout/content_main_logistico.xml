<!--        app:layout_constraintEnd_toEndOf="parent"-->
<!--        app:layout_constraintStart_toStartOf="parent"-->
<!--        app:layout_constraintTop_toTopOf="parent"/>-->

    <LinearLayout
        android:id="@+id/layoutPDV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/lPDV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium_italic"
            android:gravity="center_vertical"
            android:textColor="@color/rosa_lucky"
            android:textSize="16sp"
            android:textStyle="bold"
            />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tablalayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="35dp"

    >

        <com.google.android.material.tabs.TabItem
            android:id="@+id/relevo_logistico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/relevo_logistico" />

        <com.google.android.material.tabs.TabItem
            android:id="@+id/alerta_logistico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alerta_logistico"/>

        <com.google.android.material.tabs.TabItem
            android:id="@+id/preforma_logistico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preforma_logistico" />

    </com.google.android.material.tabs.TabLayout>

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewpager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tablalayout" />

</androidx.constraintlayout.widget.ConstraintLayout>