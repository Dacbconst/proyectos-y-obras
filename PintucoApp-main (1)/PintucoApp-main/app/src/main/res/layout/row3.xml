                    android:layout_width="150dp"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:ems="5"
                    android:padding="5dp"
                    android:text="Codigo"
                    android:textColor="#676666" />

                <TextView
                    android:id="@+id/lblUsuario"
                    android:layout_width="90dp"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:ems="5"
                    android:padding="5dp"
                    android:text="Usuario"
                    android:textColor="#676666"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/lblMarca"
                    android:layout_width="90dp"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:ems="5"
                    android:padding="5dp"
                    android:text="@string/status"
                    android:textColor="#676666" />
<!--
                <TextView
                    android:id="@+id/lblTipoexh"
                    android:layout_width="150dp"
                    android:layout_height="match_parent"
                    android:ems="5"
                    android:background="@null"
                    android:padding="5dp"
                    android:textColor="#676666"
                    android:text="@string/tipoexh"/>
-->
                <TextView
                    android:id="@+id/lblNumex"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:ems="5"
                    android:padding="5dp"
                    android:text="@string/numexh"
                    android:textColor="#676666" />

                <TextView
                    android:id="@+id/lblComentario"
                    android:layout_width="150dp"
                    android:layout_height="match_parent"
                    android:ems="5"
                    android:background="@null"
                    android:padding="5dp"
                    android:textColor="#676666"
                    android:visibility="visible"
                    android:text="@string/comentario"/>
<!--
                <TextView
                    android:id="@+id/lblFecha"
                    android:layout_width="110dp"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:ems="5"
                    android:padding="5dp"
                    android:text="@string/fecha"
                    android:textColor="#676666"
                    android:visibility="gone"/>
-->
                <TextView
                    android:id="@+id/lblNivel"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:ems="5"
                    android:padding="5dp"
                    android:text="Nivel"
                    android:visibility="gone"
                    android:textColor="#676666" />

                <TextView
                    android:id="@+id/lblTipo"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:ems="5"
                    android:padding="5dp"
                    android:text="Tipo"
                    android:textColor="#676666" />


