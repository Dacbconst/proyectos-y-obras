<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Fila normal del historial: número + fecha + chip de estado + Ver + eliminar. -->
    <LinearLayout
        android:id="@+id/contenedorFilaNormalRegistro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp">

        <TextView
            android:id="@+id/tvNumeroRegistro"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_chip_proforma_realizado"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center"
            android:textColor="@color/proforma_realizado_texto"
            android:textSize="10.5sp"
            android:textStyle="bold"
            tools:text="1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFilaNumeroRegistro"
                android:fontFamily="@font/roboto_medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:textSize="11.5sp"
                android:textStyle="bold"
                tools:text="Proforma #1" />

            <TextView
                android:id="@+id/tvFechaContactoRegistro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gris"
                android:textSize="10.5sp"
                tools:text="25/06/2026" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/chipEstadoRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/tvEstadoRegistro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="Pendiente" />

            <!-- Chevron: fila borrador/seleccionable directa. Lápiz: fila guardada,
                 requiere confirmación. Mutuamente excluyentes. -->
            <ImageView
                android:id="@+id/ivChevronEstadoRegistro"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/chevrons_down_solid_36" />

            <ImageView
                android:id="@+id/ivEditarEstadoRegistro"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:padding="1dp"
                android:src="@drawable/ic_pencil"
                android:visibility="gone"
                app:tint="@color/proforma_titulo" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnVerRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_chip_proforma_pendiente"
            android:fontFamily="@font/roboto_medium"
            android:paddingStart="9dp"
            android:paddingTop="5dp"
            android:paddingEnd="9dp"
            android:paddingBottom="5dp"
            android:text="@string/proforma_header_ver"
            android:textColor="@color/proforma_titulo"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivEliminarRegistro"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:padding="1dp"
            android:src="@drawable/ic_trash"
            android:visibility="gone"
            app:tint="@color/rojo_pintuco" />

    </LinearLayout>

    <!-- Confirmación inline de borrado: reemplaza la fila normal mientras se confirma. -->
    <LinearLayout
        android:id="@+id/contenedorConfirmarEliminarRegistro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/proforma_rechazado_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="9dp"
        android:paddingEnd="10dp"
        android:paddingBottom="9dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvConfirmarEliminarTexto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/roboto_medium"
            android:textColor="@color/proforma_rechazado_texto"
            android:textSize="11sp"
            tools:text="¿Eliminar envío #1?" />

        <TextView
            android:id="@+id/btnConfirmarEliminarNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:padding="6dp"
            android:text="@string/proforma_eliminar_no"
            android:textColor="@color/plomo_pintuco"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnConfirmarEliminarSi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_proforma_rechazado"
            android:fontFamily="@font/roboto_medium"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/proforma_eliminar_si"
            android:textColor="@color/proforma_rechazado_texto"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/proforma_detalle_borde" />

</LinearLayout>
