<?xml version="1.0" encoding="utf-8"?>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="200dp"
        android:layout_height="170dp"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:background="#e9ebeb"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="5dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@drawable/icon_warning"
            />

        <TextView
            android:id="@+id/text_dialog_title"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:gravity="center"
            android:textSize="15dp"
            android:textColor="@color/colorBlack"
            android:fontFamily="@font/roboto_black_italic"
            android:text="ATENCIÓN"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/text_dialog_desc"
            android:layout_marginBottom="5dp"
            android:gravity="center"
            android:textSize="10dp"
            android:textColor="@color/colorBlack"
            android:fontFamily="@font/roboto_medium"
            android:text="Esta cantidad para este SKU ya está registrada.\n ¿Está seguro de guardar?"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <CheckBox
            android:id="@+id/checkBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No volver a mostrar"
            android:visibility="gone"
            />

        <!-- Lista de módulos con información retenida -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_acept"
                android:layout_width="80dp"
                android:layout_height="30dp"
                android:layout_alignParentStart="true"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="10dp"
                android:textSize="11dp"
                android:background="@drawable/button_background"
                android:text="Aceptar"
                android:textColor="@color/colorWhite" />

            <Button
                android:id="@+id/btn_cancelar"
                android:layout_width="80dp"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_gravity="center_horizontal"
                android:layout_marginEnd="10dp"
                android:textSize="11dp"
                android:background="@drawable/layout_background"
                android:text="Cancelar"

                android:textColor="@color/colorWhite" />


        </RelativeLayout>


    </LinearLayout>



